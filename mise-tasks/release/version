#!/usr/bin/env bash
#MISE description="Print the next version: calendar versioning YYYY.M.PATCH, like mise"
#MISE hide=true
# 2026.11.0 is the first release of November 2026, 2026.11.1 the next one; the month restarts
# at .0. Velopack reads it as a semantic version, so updates follow the order of the releases.
set -euo pipefail

year=$(date -u +%Y)
month=$(date -u +%-m)
last=$(git tag --list 'v[0-9]*' --sort=-v:refname | head -n 1)
last=${last#v}
if [[ $last == "$year.$month."* ]]; then
	echo "$year.$month.$((${last##*.} + 1))"
else
	echo "$year.$month.0"
fi

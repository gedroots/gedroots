#!/usr/bin/env bash
#MISE description="Open or update the release pull request (version, CHANGELOG.md), like mise's release-plz"
#MISE hide=true
# Runs in the release workflow after each merge into main, with MISE_ENV=release and GH_TOKEN.
# The pull request “chore: release X” bumps the version and adds the changelog entry; merging it
# publishes the release (mise run release:tag, then the packages).
set -euo pipefail

git fetch --tags --force origin
last=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)
if [[ -z $(git log ${last:+"$last..HEAD"} --format=%s | grep -v '^chore: release') ]]; then
	echo "Nothing to release since ${last:-the first commit}"
	exit 0
fi

version=$(mise run --quiet release:version)
branch=release

# The app's version (Cargo.toml and Cargo.lock): the About box, Velopack's packages.
sed -i.bak "0,/^version = \".*\"/s//version = \"$version\"/" crates/gedroots/Cargo.toml
rm crates/gedroots/Cargo.toml.bak
cargo update --workspace --offline 2>/dev/null || cargo update --workspace
[[ -f CHANGELOG.md ]] || printf '# Changelog\n' > CHANGELOG.md
git cliff --tag "v$version" --unreleased --prepend CHANGELOG.md
notes=$(git cliff --tag "v$version" --unreleased --strip all | tail -n +3)

# The commit is created through GitHub's API rather than `git push`: GitHub signs the commits it
# creates with the workflow's token, as the branch rules require (verified signatures).
repo=${GITHUB_REPOSITORY:?}
base=$(git rev-parse HEAD)
if gh api "repos/$repo/git/ref/heads/$branch" > /dev/null 2>&1; then
	gh api -X PATCH "repos/$repo/git/refs/heads/$branch" -f sha="$base" -F force=true > /dev/null
else
	gh api -X POST "repos/$repo/git/refs" -f ref="refs/heads/$branch" -f sha="$base" > /dev/null
fi
files=(crates/gedroots/Cargo.toml Cargo.lock CHANGELOG.md)
# Contents go through files, never arguments: Cargo.lock in base64 is too long for the command line.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
for f in "${files[@]}"; do
	base64 -w0 "$f" > "$tmp/contents"
	jq -n --arg path "$f" --rawfile contents "$tmp/contents" '{path: $path, contents: $contents}' > "$tmp/$(basename "$f").json"
done
jq -s . "$tmp"/*.json > "$tmp/additions"
jq -n --arg repo "$repo" --arg branch "$branch" --arg head "$base" --arg message "chore: release $version" \
	--slurpfile additions "$tmp/additions" '{
		query: "mutation($input: CreateCommitOnBranchInput!) { createCommitOnBranch(input: $input) { commit { oid } } }",
		variables: {input: {
			branch: {repositoryNameWithOwner: $repo, branchName: $branch},
			expectedHeadOid: $head,
			message: {headline: $message},
			fileChanges: {additions: $additions[0]}
		}}
	}' > "$tmp/request"
gh api graphql --input "$tmp/request" --jq .data.createCommitOnBranch.commit.oid
git checkout -- "${files[@]}" 2> /dev/null || true

title="chore: release $version"
body=$(printf 'Merging this pull request publishes GEDRoots %s: tag, installers for macOS, Windows and Linux, update packages, release notes.\n\n%s\n' "$version" "$notes")
if gh pr view "$branch" --json state --jq .state 2>/dev/null | grep -q OPEN; then
	gh pr edit "$branch" --title "$title" --body "$body"
else
	gh pr create --head "$branch" --base main --title "$title" --body "$body"
fi

#!/usr/bin/env bash
#MISE description="Build GEDRoots' installers and update packages for this system (Velopack)"
#USAGE flag "--upload" help="Add them to this version's draft GitHub release"
#
# Needs the release tools: `MISE_ENV=release mise run package`. Output in <target>/dist:
# - macOS: GEDRoots.dmg, GEDRoots-osx-Setup.pkg, GEDRoots-osx-Portable.zip;
# - Windows: GEDRoots-win-Setup.exe, GEDRoots-win-Portable.zip;
# - Linux: GEDRoots.AppImage;
# and the update packages (*.nupkg) with their feed (releases.<channel>.json), which the app reads
# to update itself (crates/gedroots/src/updates.rs).
#
# Not signed with a trusted certificate (Apple Developer ID, Windows code signing): macOS asks to
# confirm the first launch in System Settings › Privacy & Security, Windows SmartScreen in “More
# info”. On macOS the app is signed with GEDRoots' self-signed certificate when
# MACOS_CERTIFICATE (base64 .p12) and MACOS_CERTIFICATE_PASSWORD are set (secrets created by
# `mise run release:certificate`): its code identity then stays the same from one version to the
# next, so macOS keeps the permissions given to the app (folders, local network…) after an
# update. Without them it is signed ad hoc, and each version is a new app for macOS.
set -euo pipefail

ID=GEDRoots
REPO=$(sed -n 's/^repository = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
VERSION=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/gedroots/Cargo.toml | head -n 1)
TARGET=$(cargo metadata --format-version 1 --no-deps | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
DIST="$TARGET/dist"
NOTES="$DIST/notes.md"
upload=${usage_upload:-false}

rm -rf "$DIST"
mkdir -p "$DIST"
# This version's entry of CHANGELOG.md: shown by Velopack's feed.
awk '/^## \[/{n++} n==1' CHANGELOG.md > "$NOTES" 2>/dev/null || true

# The previous release, so that vpk makes a delta package (smaller update).
if [ "$upload" = true ]; then
	vpk download github --repoUrl "$REPO" --token "$GH_TOKEN" -o "$DIST" || true
fi

common=(-u "$ID" -v "$VERSION" -o "$DIST" --packTitle GEDRoots --packAuthors "The GEDRoots contributors" --releaseNotes "$NOTES")
case "$(uname -s)" in
Darwin)
	mise run bundle
	# vpk signs the bundle again after adding its updater to it.
	identity=-
	keychain=()
	if [ -n "${MACOS_CERTIFICATE:-}" ]; then
		# A throwaway keychain holding the certificate, unlocked for codesign.
		KEYCHAIN="${RUNNER_TEMP:-$(mktemp -d)}/gedroots-signing.keychain-db"
		KEYCHAIN_PASSWORD=$(openssl rand -hex 16)
		P12=$(mktemp)
		trap 'rm -f "$P12"; security delete-keychain "$KEYCHAIN" 2> /dev/null || true' EXIT
		printf '%s' "$MACOS_CERTIFICATE" | base64 --decode > "$P12"
		security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
		security set-keychain-settings -lut 21600 "$KEYCHAIN"
		security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
		# `-f`: the temporary file has no .p12 extension to tell the format.
		security import "$P12" -k "$KEYCHAIN" -f pkcs12 -P "$MACOS_CERTIFICATE_PASSWORD" -T /usr/bin/codesign
		security set-key-partition-list -S apple-tool:,apple: -s -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN" > /dev/null
		# codesign only looks for identities in the search list.
		security list-keychains -d user -s "$KEYCHAIN" $(security list-keychains -d user | tr -d '"')
		# Common name given by `mise run release:certificate`.
		identity="GEDRoots Code Signing"
		keychain=(--keychain "$KEYCHAIN")
	else
		echo "warning: MACOS_CERTIFICATE is not set, signing ad hoc: macOS will ask for its permissions again after the update" >&2
	fi
	vpk pack "${common[@]}" -p "$TARGET/release/GEDRoots.app" -e gedroots --signAppIdentity "$identity" ${keychain[@]+"${keychain[@]}"}
	# Disk image: the app and a link to Applications, to drag one onto the other.
	STAGE=$(mktemp -d)
	ditto -x -k "$DIST/$ID-osx-Portable.zip" "$STAGE"
	codesign --verify --deep --strict "$STAGE/GEDRoots.app"
	# The designated requirement is the identity macOS remembers the permissions for: it must not
	# be the hash of this build.
	codesign --display --requirements - "$STAGE/GEDRoots.app" 2>&1 | tee "$DIST/requirement.txt"
	if [ "$identity" != - ] && grep -q 'cdhash' "$DIST/requirement.txt"; then
		echo "error: the app's designated requirement depends on this build" >&2
		exit 1
	fi
	rm "$DIST/requirement.txt"
	ln -s /Applications "$STAGE/Applications"
	hdiutil create -volname GEDRoots -srcfolder "$STAGE" -ov -format UDZO "$DIST/GEDRoots.dmg" > /dev/null
	rm -rf "$STAGE"
	;;
MINGW* | MSYS* | CYGWIN*)
	cargo build --release -p gedroots
	STAGE=$(mktemp -d)
	cp "$TARGET/release/gedroots.exe" "$STAGE/"
	vpk pack "${common[@]}" -p "$STAGE" -e gedroots.exe -i packaging/windows/gedroots.ico
	;;
Linux)
	cargo build --release -p gedroots
	STAGE=$(mktemp -d)
	cp "$TARGET/release/gedroots" "$STAGE/"
	vpk pack "${common[@]}" -p "$STAGE" -e gedroots -i packaging/icon.png --categories "Office;Education"
	;;
esac
ls -l "$DIST"

if [ "$upload" = true ]; then
	vpk upload github --repoUrl "$REPO" --token "$GH_TOKEN" -o "$DIST" --merge --tag "v$VERSION" --releaseName "GEDRoots $VERSION"
	if [ -f "$DIST/GEDRoots.dmg" ]; then
		gh release upload "v$VERSION" "$DIST/GEDRoots.dmg" --clobber
	fi
fi

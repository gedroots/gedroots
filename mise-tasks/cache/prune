#!/usr/bin/env bash
#MISE description="Delete the older GitHub Actions caches of one kind, keeping the one just saved (CI)"
#USAGE arg "<prefix>" help="Start of the cache keys, e.g. release-Linux-"
#USAGE arg "<keep>" help="Key of the cache to keep"
#
# Each save on main makes a new key (Cargo.lock changes with every release), and the old ones
# stayed until GitHub dropped them past the repository's 10 GB. It drops the least recently used
# first: the release caches, read once per release, went before the release that needed them.
# Needs GH_TOKEN with the `actions: write` permission.
set -euo pipefail

gh cache list --key "$usage_prefix" --limit 100 --json id,key \
	--jq ".[] | select(.key != \"$usage_keep\") | .id" |
	while read -r id; do
		gh cache delete "${id%$'\r'}"
	done
